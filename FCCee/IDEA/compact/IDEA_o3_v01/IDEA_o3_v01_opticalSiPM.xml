<?xml version="1.0" encoding="UTF-8"?>
<lccdd xmlns:compact="http://www.lcsim.org/schemas/compact/1.0"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xs:noNamespaceSchemaLocation="http://www.lcsim.org/schemas/compact/1.0/compact.xsd">

  <info name="IDEA_o3_v01_opticalSiPM"
    title="FCCee IDEA option 3 detector geometry master file, with the fiber DRC SiPM wafer sensitive"
    author="Option 3 assembled from IDEA_o2_v01 (SCEPCal crystal ECAL by Wonyong Chung, vertex/silicon wrapper by Armin Ilg, DCH by Alvaro Tolosa-Delgado) with the hadronic calorimeter replaced by the Korean fiber Dual-Readout Calorimeter (Sanghyun Ko, Sungwon Kim)"
    url="no"
    status="development"
    version="o3_v01">
    <comment>
      Version o3_v01 of the IDEA detector, to be used with the simulation modes that
      transport optical photons up to the photo-sensor of the fiber dual-readout
      calorimeter (DRCaloSDAction with skipScint=false, i.e. the full-sim and fast-sim
      steering files). The only difference with respect to IDEA_o3_v01.xml is that the
      DRC is taken from FiberDualReadoutCalo_o1_v01_opticalSiPM.xml, where the SiPM wafer
      is a sensitive volume instead of the fibers.
      Identical to IDEA_o2_v01 except that the Italian tube-based dual-readout
      calorimeter (DREndcapTubes + DRBarrelTubes) is replaced by the monolithic
      fiber-based dual-readout calorimeter (FiberDualReadoutCalo_o1_v01, from
      IDEA_o1_v03), rescaled to occupy the same hadronic envelope (barrel r
      2805 -> 4600 mm, half-length 2805 mm) just outside the solenoid. The
      SCEPCal crystal ECAL is kept unchanged as the electromagnetic calorimeter.
    </comment>
  </info>

  <include ref="${DD4hepINSTALL}/DDDetectors/compact/detector_types.xml" />

  <includes>
    <gdmlFile  ref="../IDEA_o1_v03/elements_o1_v01.xml"/>
    <gdmlFile  ref="../IDEA_o2_v01/materials_o2_v01.xml"/>
  </includes>

  <define>
    <constant name="world_size" value="25*m"/>
    <constant name="world_x" value="world_size"/>
    <constant name="world_y" value="world_size"/>
    <constant name="world_z" value="world_size"/>
  </define>

  <!-- Import dimensions -->
  <include ref="DectDimensions_IDEA_o3_v01.xml"/>

  <!-- Import visualization (color) definitions -->
  <include ref="display.xml"/>

  <!-- Import accelerator components -->
  <!-- shape based model of the beam pipe -->
  <include ref="../../../MDI/compact/MDI_o1_v00/Beampipe_o4_v05.xml" />
  <include ref="../../../MDI/compact/MDI_o1_v00/BeamInstrumentation_o1_v01.xml" />

  <!-- engineered CAD model of the beam pipe -->
  <!-- In order to use the CAD beampipe, build k4geo with the following CMake option: 
  cmake -D INSTALL_BEAMPIPE_STL_FILES=ON which will download the files needed -->
  <!-- <include ref="../../../MDI/compact/MDI_o1_CADBased_v01/MDI_o1_CADBased_v01_collection.xml" />
  <world material="Vacuum"/> -->

  <include ref="../IDEA_o1_v03/LumiCal_o1_v01.xml"/>

  <!-- Import vertex -->
  <include ref="../IDEA_o1_v04/VertexComplete_o1_v04.xml"/>

  <!-- Import drift chamber -->
  <include ref="../IDEA_o1_v03/DriftChamber_o1_v02.xml"/>

  <!-- Import silicon wrapper -->
  <include ref="../IDEA_o1_v04/SiliconWrapper_o1_v02.xml"/>

  <!-- Import solenoid -->
  <include ref="../IDEA_o1_v03/Solenoid_o1_v01.xml"/>

  <!-- Import Endcap plate absorber -->
  <include ref="../IDEA_o1_v03/EndPlateAbsorber_o1_v01.xml"/>

  <!-- Import dual-readout segmented crystal calorimeter (EM), unchanged from option 2 -->
  <include ref="../IDEA_o2_v01/SCEPCal_o1_v01.xml"/>

  <!-- Import Korean fiber-based dual-readout calorimeter (hadronic), replacing the
       option-2 tube-based barrel+endcap. Self-contained (materials, readout,
       segmentation); its size is driven by the FiberDRCalo_* constants and DRC*
       vis attributes defined in DectDimensions_IDEA_o3_v01.xml / display.xml.
       Local copy of the IDEA_o1_v03 file with the SiPM wafer declared sensitive. -->
  <include ref="FiberDualReadoutCalo_o1_v01_opticalSiPM.xml"/>

  <!-- Import muon system -->
  <include ref="../IDEA_o1_v03/MuonSystem_o1_v01.xml"/>

  <plugins>
    <plugin name="DD4hepVolumeManager"/>
    <plugin name="InstallSurfaceManager"/>
  </plugins>

  <fields>
    <!-- FIXME The magnetic field should be a map derived from FEM tools including all field sources, the return yoke geometry, etc -->
    <!-- Currently the outer field value is kind of arbitrary and it will also impregnate the calorimeter volume while the field there is very small -->
    <field name="GlobalSolenoid" type="solenoid"
           inner_field="SolenoidField"
           outer_field="-1.7*tesla"
           zmax="1.2 * Solenoid_Coil_half_length"
           outer_radius="Solenoid_Coil_radius">
    </field>

  </fields>

</lccdd>
